build/
build_cpu/
# No dot-prefixed file or dir is ever COPYed by either Dockerfile; excluding
# them wholesale keeps editor/VCS/tooling state out of the build context.
.*
__pycache__/
*.pyc
bench_docs/
test_images/
tests/test_data/
benchmark/data/
benchmark/results/
# Models are fetched from the GitHub Release at build time (RUN
# fetch_release_models.sh) — neither Dockerfile COPYs models/, so excluding the
# whole tree just keeps the build context small (no GB of unused .onnx shipped).
models/
*.log
*.trt
LICENSE
README.md
tests/benchmark/
tests/integration/
tests/regression/
tests/fixtures/

# Local artifacts never COPYed by docker/Dockerfile.{nvidia,cpu} (models are fetched
# at build time, not copied). Excluding them keeps the build context lean.
models.bak/
model.cache
model.cache.bak
build-cpu/
result/
predeploy/
sdk/
uploads/
custom_models/
webui/
build-coverage/
# Never ship the local vendored ORT into the build context: the Dockerfiles
# fetch their own pinned CUDA-13 build, and excluding it keeps docker builds
# byte-equivalent to a clean clone (plus ~275 MB less context).
third_party/onnxruntime/
# macOS PDFium is vendored for native darwin builds; Linux images never load it.
third_party/pdfium/lib/libpdfium.dylib

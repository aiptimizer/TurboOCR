#!/usr/bin/env bash
# Fast static checks on STAGED files only. Budget: < 20 s total (hard-capped).
# Every check exists because the class of defect it catches has actually
# occurred in this repo; see docs/dev/pre_commit.md for the rationale and the
# escape hatch (git commit --no-verify) for intentional exceptions.
set -u

HARD_TIMEOUT=20
START=$(date +%s)

fail=0
say() { printf '%s\n' "$*" >&2; }
budget_left() { echo $(( HARD_TIMEOUT - ( $(date +%s) - START ) )); }

# Staged file lists (names only; content read from the index, not the tree).
mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR)
[ ${#STAGED[@]} -eq 0 ] && exit 0

cxx_files=() cmake_files=()
for f in "${STAGED[@]:-}"; do
  [ -n "$f" ] || continue
  case "$f" in
    third_party/*|build*/*) continue ;;
    *.cpp|*.h|*.cu|*.cuh) cxx_files+=("$f") ;;
    CMakeLists.txt|*.cmake) cmake_files+=("$f") ;;
  esac
done

# Staged content of a file (index version, not working tree).
staged() { git show ":$1" 2>/dev/null; }

# ---- 1. Console logging bypasses the structured logger -----------------
# src/ library code must log through logger.h (level control + rate limits).
# tools/, tests/, benchmarks and the CLI (src/cli/ — stdout IS its product)
# keep plain streams.
for f in "${cxx_files[@]:-}"; do
  [ -n "$f" ] || continue
  case "$f" in
    src/cli/*) continue ;;   # CLI: stdout is the deliverable, not diagnostics
    src/*) ;;
    *) continue ;;
  esac
  if staged "$f" | grep -nE '(std::)?(cerr|cout) *<<' | grep -vq 'pre-commit-allow-stream'; then
    say "pre-commit: $f writes to std::cout/std::cerr — use TOCR_LOG_* (logger.h)."
    say "           (append // pre-commit-allow-stream on the line for a deliberate exception)"
    fail=1
  fi
done

# ---- 2. Ad-hoc getenv outside the env_utils parsers --------------------
# Every config knob goes through turbo_ocr::env (strict/lenient parse,
# empty-as-unset, clamping) — no more hand-pasted to_int/get_env copies.
for f in "${cxx_files[@]:-}"; do
  [ -n "$f" ] || continue
  case "$f" in
    src/*|include/*) ;;
    *) continue ;;
  esac
  case "$f" in
    include/turbo_ocr/common/env_utils.h) continue ;;
  esac
  if staged "$f" | grep -nE '(std::)?getenv *\(' \
      | grep -vqE 'pre-commit-allow-getenv'; then
    say "pre-commit: $f calls getenv directly — use turbo_ocr::env helpers (env_utils.h)."
    say "           (append // pre-commit-allow-getenv for a deliberate presence-only probe)"
    fail=1
  fi
done

# ---- 3. Unguarded std::stoi/stol family --------------------------------
# They throw on garbage; parsing must go through std::from_chars or a
# try-scoped helper (see parse_daemon_page_count for the pattern).
for f in "${cxx_files[@]:-}"; do
  [ -n "$f" ] || continue
  if staged "$f" | grep -nE '(std::)?\bsto(i|l|ul|ll|ull|f|d|ld)\(' \
      | grep -vqE 'pre-commit-allow-stoi'; then
    say "pre-commit: $f uses std::stoi/stol — prefer std::from_chars with explicit error handling."
    fail=1
  fi
done

# ---- 4. CMake hygiene ---------------------------------------------------
for f in "${cmake_files[@]:-}"; do
  [ -n "$f" ] || continue
  if staged "$f" | grep -nqE 'file *\( *GLOB'; then
    say "pre-commit: $f uses file(GLOB) — list sources explicitly."
    fail=1
  fi
done
# A CMakeLists.txt that no other CMakeLists includes misleads contributors.
# add_subdirectory() references a child by the path relative to the INCLUDING
# file, so a nested foo/bar/CMakeLists is referenced as `add_subdirectory(bar)`
# in foo/CMakeLists — match either the full repo-relative dir OR the leaf name,
# across ALL tracked CMakeLists (not just the top one), with regex metachars
# escaped so a dir like `a.b` can't match loosely.
re_escape() { printf '%s' "$1" | sed 's/[][\\.^$*+?(){}|/]/\\&/g'; }
for f in "${cmake_files[@]:-}"; do
  [ -n "$f" ] || continue
  case "$f" in
    CMakeLists.txt) continue ;;
    */CMakeLists.txt) ;;
    *) continue ;;
  esac
  dir=$(dirname "$f")
  esc_dir=$(re_escape "$dir")
  esc_leaf=$(re_escape "$(basename "$dir")")
  pat="add_subdirectory *\\( *\"?(${esc_dir}|${esc_leaf})\"?"
  if ! git ls-files -- '*CMakeLists.txt' 2>/dev/null \
       | xargs -r grep -lE "$pat" 2>/dev/null | grep -q .; then
    say "pre-commit: $f is not referenced by any add_subdirectory(${dir}) — orphaned CMakeLists are banned."
    fail=1
  fi
done

# ---- 5. cppcheck on STAGED content (time-boxed) ------------------------
# The staged blob is what gets committed, so that is what gets checked —
# a partially-staged file must be judged on its index version, not the
# dirty worktree. Staged .cpp blobs are materialized into a temp tree
# preserving relative paths; the repo's include/ and root are passed via -I
# so `#include "turbo_ocr/..."` and file-relative headers resolve (headers
# themselves come from the worktree, which is correct for cross-TU type info).
repo_root=$(git rev-parse --show-toplevel)
if command -v cppcheck >/dev/null 2>&1 && [ ${#cxx_files[@]} -gt 0 ]; then
  left=$(budget_left)
  if [ "$left" -ge 5 ]; then
    tmpdir=$(mktemp -d) || tmpdir=""
    trap '[ -n "$tmpdir" ] && rm -rf "$tmpdir"' EXIT
    cpp_only=()
    for f in "${cxx_files[@]}"; do
      case "$f" in
        *.cpp)
          mkdir -p "$tmpdir/$(dirname "$f")"
          if staged "$f" > "$tmpdir/$f" 2>/dev/null; then
            cpp_only+=("$tmpdir/$f")
          fi
          ;;
      esac
    done
    if [ ${#cpp_only[@]} -gt 0 ]; then
      cppcheck_out=$(timeout "$left" cppcheck --quiet --error-exitcode=1 \
             --enable=warning,performance,portability \
             --suppress=missingIncludeSystem --inline-suppr \
             -I "$repo_root/include" -I "$repo_root" \
             -j"$(nproc)" "${cpp_only[@]}" 2>&1)
      rc=$?
      if [ "$rc" = "124" ]; then
        say "pre-commit: cppcheck hit the time budget — treat as pass, run manually if needed."
      elif [ "$rc" != "0" ]; then
        printf '%s\n' "${cppcheck_out//$tmpdir\//}" | head -30 >&2
        say "pre-commit: cppcheck found issues (see above)."
        fail=1
      fi
    fi
  else
    say "pre-commit: skipping cppcheck (time budget consumed)."
  fi
fi

elapsed=$(( $(date +%s) - START ))
if [ "$fail" -ne 0 ]; then
  say "pre-commit: FAILED in ${elapsed}s. Fix the findings or use --no-verify for a justified exception."
  exit 1
fi
exit 0

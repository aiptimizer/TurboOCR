daemon on;
pid /tmp/nginx.pid;
worker_processes auto;
worker_rlimit_nofile 65535;
error_log /dev/stderr error;

events {
    worker_connections 4096;
    multi_accept on;
}

http {
    access_log off;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    default_type application/json;

    upstream ocr_backend {
        server 127.0.0.1:${PORT};
        keepalive 128;
    }

    server {
        listen 8000 backlog=4096 reuseport;

        client_max_body_size ${MAX_BODY_MB}m;
        proxy_connect_timeout 120s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_next_upstream off;

        # Slow-loris mitigation: reap clients that open a connection and then
        # trickle (or never send) the request header/body or stall reading the
        # response, instead of pinning an nginx worker for proxy_*_timeout.
        # 60s matches nginx's own default (so this only adds an explicit floor,
        # never shrinks a window an existing slow-upload client relied on).
        client_header_timeout 60s;
        client_body_timeout 60s;
        send_timeout 60s;

        # JSON error pages for all nginx-generated errors
        error_page 413 =413 @error_413;
        error_page 502 =502 @error_502;
        error_page 504 =504 @error_504;

        location @error_413 {
            return 413 '{"error":"Request body too large (max ${MAX_BODY_MB}MB)"}';
        }
        location @error_502 {
            return 502 '{"error":"Backend unavailable"}';
        }
        location @error_504 {
            return 504 '{"error":"Backend timeout"}';
        }

        # NOTE: /metrics exposes VRAM/topology. Restricting it is the fronting
        # gateway's job (this server is meant to sit behind one); the bundled
        # proxy intentionally does not add an allow/deny here so it stays a
        # drop-in for existing scrapers.

        location / {
            proxy_pass http://ocr_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header X-Request-Id $http_x_request_id;
        }
    }
}
